{
    "exclude": ["node_modules"],
    "include": ["src"],
    "compilerOptions": {
        "types": ["node"],
        "strict": true,
        "module": "NodeNext",
        "outDir": "build",
        "rootDir": "./src/",
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noErrorTruncation": true,
        "noUnusedParameters": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "noUncheckedIndexedAccess": true
    }
}